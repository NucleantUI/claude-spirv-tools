#!/bin/sh
# Starts the plugin's MCP server, from the release build: the plugin folder's own
# .build/release (a plugin added from a local folder runs in place, so that is
# the clone's build), or else ${CLAUDE_PLUGIN_DATA}/release, where an
# installed copy keeps its binaries.
root="$(cd "$(dirname "$0")/.." && pwd)"
for dir in "$root/.build/release" "${CLAUDE_PLUGIN_DATA:+$CLAUDE_PLUGIN_DATA/release}"; do
    [ -n "$dir" ] && [ -x "$dir/spirv-mcp" ] && exec "$dir/spirv-mcp" "$@"
done
echo "spirv-tools: spirv-mcp is not built. In the plugin folder run:" >&2
echo "  cd \"$root\" && uv run scripts/build_spirv_tools.py && swift build -c release" >&2
exit 1
