#!/bin/sh
# Runs spirv-check (the PostToolUse hook with --hook) from the release build:
# the plugin folder's own .build/release (a plugin added from a local folder
# runs in place, so that is the clone's build), or else
# ${CLAUDE_PLUGIN_DATA}/release, where an installed copy keeps its binaries.
root="$(cd "$(dirname "$0")/.." && pwd)"
for dir in "$root/.build/release" "${CLAUDE_PLUGIN_DATA:+$CLAUDE_PLUGIN_DATA/release}"; do
    [ -n "$dir" ] && [ -x "$dir/spirv-check" ] && exec "$dir/spirv-check" "$@"
done
[ "$1" = "--hook" ] && exit 0
echo "spirv-tools: spirv-check is not built. In the plugin folder run:" >&2
echo "  cd \"$root\" && swift build -c release" >&2
exit 1
